{
  "name": "pbc-api",
  "version": "1.0.0",
  "description": "API for pbc (Pakistan Business Council / Mideast Metals) project.",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:setup": "npm run prisma:generate && npm run prisma:migrate",
    "start:dev": "npm run db:setup && npm start",
    "start": "node dist/index.js",
    "deploy": "npm run db:setup && npm run start",
    "lint": "prettier --write .",
    "seed": "tsx prisma/seed.ts",
    "seedProd": "tsx prisma/seedProd.ts",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.782.0",
    "@casl/ability": "^6.7.3",
    "@prisma/client": "^6.4.1",
    "@sendgrid/mail": "^8.1.5",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "expo-server-sdk": "^3.15.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "luhn": "^2.4.1",
    "luxon": "^3.7.1",
    "mime-types": "^3.0.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "prisma": "^6.4.1",
    "socket.io": "^4.8.1",
    "twilio": "^5.5.1",
    "winston": "^3.17.0"
  },
  "lint-staged": {
    "*": [
      "npm run lint"
    ]
  },
  "devDependencies": {
    "@faker-js/faker": "^9.6.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/luxon": "^3.6.2",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "@types/node-cron": "^3.0.11",
    "@types/socket.io": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "undici-types": "^7.3.0"
  }
}
